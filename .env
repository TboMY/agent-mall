# LLM - Video Analysis
LLM_API_BASE_VIDEO_ANALYSIS=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY_VIDEO_ANALYSIS=sk-60b85e9b50bb440489504d62a6c95395
LLM_MODEL_VIDEO_ANALYSIS=qwen3.5-flash
LLM_TEMPERATURE_VIDEO_ANALYSIS=0

# LLM - Keyword Filter
LLM_API_BASE_KEYWORD_FILTER=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY_KEYWORD_FILTER=sk-60b85e9b50bb440489504d62a6c95395
LLM_MODEL_KEYWORD_FILTER=qwen3.5-flash
LLM_TEMPERATURE_KEYWORD_FILTER=0.2

# Hotlist API
HOTLIST_API_BASE=https://api.98dou.cn
HOTLIST_API_TIMEOUT_MS=15000
HOTLIST_REFRESH_COOLDOWN_SEC=60
KEYWORD_FILTER_BATCH_SIZE=100

# Collector
COLLECTOR_MAX_VIDEO_MB=100
COLLECTOR_HEADLESS=false

# Douyin Browser Mode
# COLLECTOR_DOUYIN_BROWSER_MODE:
# - cdp: 连接你已经手动打开的 Chrome（适合开发调试，会看到标签页）
# - persistent: 程序自己启动独立浏览器用户目录（适合登录预热或静默采集）
COLLECTOR_DOUYIN_BROWSER_MODE=cdp

# 当 browser mode=cdp 时使用。
# 你需要先手动启动浏览器：
# "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222 --user-data-dir="D:\About_Browser\dev_user_data"
COLLECTOR_DOUYIN_CDP_URL=http://127.0.0.1:9222

# 指向本机 Chrome 路径。persistent 模式下由程序自己拉起浏览器时会用到。
COLLECTOR_DOUYIN_EXECUTABLE_PATH=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe

# 抖音 crawler 自己的浏览器用户目录。
# - 如果你想和日常开发浏览器完全隔离，建议用 douyin_crawler_profile
# - 如果你想直接复用手动开的 dev 浏览器登录态，改成 D:\About_Browser\dev_user_data
COLLECTOR_DOUYIN_USER_DATA_DIR=D:\About_Browser\douyin_crawler_profile

# Chrome 远程调试端口。CDP 模式下需要和你手动启动浏览器时传入的端口一致。
COLLECTOR_DOUYIN_REMOTE_DEBUGGING_PORT=9222

# COLLECTOR_DOUYIN_SILENT:
# - true: 走“尽量静默”的采集思路，不适合 cdp
# - false: 开发调试更友好
COLLECTOR_DOUYIN_SILENT=false

# COLLECTOR_DOUYIN_HEADLESS:
# - true: 无头浏览器，不显示窗口
# - false: 有界面浏览器
# 注意：cdp 模式下是否可见，主要取决于你手动打开的那个 Chrome，本项主要对 persistent 模式生效
COLLECTOR_DOUYIN_HEADLESS=false

# 推荐用法：
# 1. 开发调试 / 演示时想复用你手动开的 dev Chrome：
#    COLLECTOR_DOUYIN_BROWSER_MODE=cdp
#    COLLECTOR_DOUYIN_CDP_URL=http://127.0.0.1:9222
#    COLLECTOR_DOUYIN_USER_DATA_DIR=D:\About_Browser\dev_user_data
#    COLLECTOR_DOUYIN_SILENT=false
#    COLLECTOR_DOUYIN_HEADLESS=false
#
# 2. 想尝试独立静默采集（更容易被抖音风控）：
#    COLLECTOR_DOUYIN_BROWSER_MODE=persistent
#    COLLECTOR_DOUYIN_USER_DATA_DIR=D:\About_Browser\douyin_crawler_profile
#    COLLECTOR_DOUYIN_SILENT=true
#    COLLECTOR_DOUYIN_HEADLESS=true

